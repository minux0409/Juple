<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required by React Native's HeadlessJsTaskService to keep the device awake while the background share-save task runs. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+ (API 33+) requires this manifest declaration before the runtime prompt (see src/push/pushPermission.ts) can be requested at all - targetSdkVersion is 36 here, so this is not optional. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <!-- MainActivity's configChanges: `density` is not in RN's default template but is required
           for foldables - Galaxy Z Fold-class devices change display density on fold/unfold, and
           without it the Activity is recreated mid-edit (navigation state and unsaved input are
           lost - reproduced on the resizable emulator). React Native 0.87 handles density changes
           in onConfigurationChanged (ReactHostImpl re-inits DisplayMetricsHolder via the
           default-on enableFontScaleChangesUpdatingLayout flag), so no recreation is needed. -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|density|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!--
          Android App Links for the Public Collection Sharing link (https://<host>/c/{publicId} ->
          SharedCollectionScreen - see src/navigation/linking.ts's matching JS-side config).
          android:host is a manifest placeholder (see android/app/build.gradle's defaultConfig) -
          no real production domain exists yet (see docs/architecture.md), so it defaults to an
          RFC 2606 reserved, guaranteed-unresolvable placeholder host rather than a fabricated one.
          autoVerify="true" is inert until that placeholder is overridden with a real domain AND
          that domain serves a correct /.well-known/assetlinks.json (see apps/web) - until then
          Android simply never verifies this intent-filter, and the OS falls back to its normal
          disambiguation/browser behavior, never a crash.
        -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data
                android:scheme="https"
                android:host="${appLinksHost}"
                android:pathPrefix="/c/" />
        </intent-filter>
      </activity>
      <activity
        android:name=".ShareReceiverActivity"
        android:theme="@style/NoDisplayTheme"
        android:noHistory="true"
        android:excludeFromRecents="true"
        android:taskAffinity=""
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.SEND" />
          <category android:name="android.intent.category.DEFAULT" />
          <data android:mimeType="text/plain" />
        </intent-filter>
        <!-- Sharing Shortcuts API: associates ShortcutSyncManager's dynamic category shortcuts with this Activity's ACTION_SEND intent-filter above, so the Sharesheet can offer them as Direct Share targets. -->
        <meta-data
            android:name="android.app.shortcuts"
            android:resource="@xml/shortcuts" />
      </activity>
      <service
        android:name=".IncomingShareHeadlessService"
        android:exported="false" />
    </application>
</manifest>
