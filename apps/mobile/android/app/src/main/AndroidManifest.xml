<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required by React Native's HeadlessJsTaskService to keep the device awake while the background share-save task runs. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+ (API 33+) requires this manifest declaration before the runtime prompt (see src/push/pushPermission.ts) can be requested at all - targetSdkVersion is 36 here, so this is not optional. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!--
          Android App Links for the Public Collection Sharing link (https://<host>/c/{publicId} ->
          SharedCollectionScreen - see src/navigation/linking.ts's matching JS-side config).
          android:host is a manifest placeholder (see android/app/build.gradle's defaultConfig) -
          no real production domain exists yet (see docs/architecture.md), so it defaults to an
          RFC 2606 reserved, guaranteed-unresolvable placeholder host rather than a fabricated one.
          autoVerify="true" is inert until that placeholder is overridden with a real domain AND
          that domain serves a correct /.well-known/assetlinks.json (see apps/web) - until then
          Android simply never verifies this intent-filter, and the OS falls back to its normal
          disambiguation/browser behavior, never a crash.
        -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data
                android:scheme="https"
                android:host="${appLinksHost}"
                android:pathPrefix="/c/" />
        </intent-filter>
      </activity>
      <activity
        android:name=".ShareReceiverActivity"
        android:theme="@style/NoDisplayTheme"
        android:noHistory="true"
        android:excludeFromRecents="true"
        android:taskAffinity=""
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.SEND" />
          <category android:name="android.intent.category.DEFAULT" />
          <data android:mimeType="text/plain" />
        </intent-filter>
        <!-- Sharing Shortcuts API: associates ShortcutSyncManager's dynamic category shortcuts with this Activity's ACTION_SEND intent-filter above, so the Sharesheet can offer them as Direct Share targets. -->
        <meta-data
            android:name="android.app.shortcuts"
            android:resource="@xml/shortcuts" />
      </activity>
      <!--
        Quick Save composer: a small dialog-styled Activity shown over the sharing app when
        "공유 즉시 저장" is ON (see ShareReceiverActivity/QuickSaveOnSharePreference) - deliberately
        not exported (only ShareReceiverActivity starts it) and not MainActivity, so it never boots
        the app's full navigation stack just to confirm a title/category before saving.
        taskAffinity="" (matching ShareReceiverActivity above) is required, not cosmetic: without
        it this Activity falls back to the default (package-name) affinity, the same one
        MainActivity uses, so FLAG_ACTIVITY_NEW_TASK below would join MainActivity's existing task
        instead of creating a fresh one whenever that task is still alive in the background -
        bringing MainActivity's last screen to the front underneath this translucent composer
        instead of leaving the sharing app visible. excludeFromRecents keeps that
        always-freshly-created task from ever showing as its own entry in Recents.
      -->
      <activity
        android:name=".QuickSaveComposerActivity"
        android:theme="@style/QuickSaveComposerTheme"
        android:windowSoftInputMode="adjustResize"
        android:taskAffinity=""
        android:excludeFromRecents="true"
        android:exported="false" />
      <service
        android:name=".IncomingShareHeadlessService"
        android:exported="false" />
    </application>
</manifest>
