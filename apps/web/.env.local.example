# Copy this file to .env.local for local development. Every value is read at RUNTIME on the server (never NEXT_PUBLIC_*):
# one built image serves every environment, configured by its own environment variables (see Dockerfile).

# The Juple Backend's base URL - the public viewer and the signed-in app both call it. Falls back to http://localhost:5092 if
# unset. No real Production domain is configured here.
JUPLE_API_BASE_URL=http://localhost:5092

# Signed-in Web app (Microsoft Entra External ID, Authorization Code + PKCE - a browser app has NO client secret). Public
# identifiers only, handed to the browser by app/(app)/layout.tsx. These are the DEV External ID tenant's values; without
# them the signed-in pages say sign-in is not configured (the public viewer and legal pages keep working).
JUPLE_ENTRA_AUTHORITY=https://jupledev.ciamlogin.com/
# The tenant id: External ID issues its tokens from {tenantId}.ciamlogin.com, which MSAL must be told to trust (see lib/webAppConfig.ts).
JUPLE_ENTRA_TENANT_ID=d2e79a05-cf5f-43ab-86d2-717e025a74b1
JUPLE_ENTRA_WEB_CLIENT_ID=d70ac03c-811e-4535-868e-9cb94d66db64
JUPLE_ENTRA_API_SCOPE=api://14bcc3b7-7b37-4051-9e40-63cc2a5ffc8b/access_as_user
# This app's own origin: the redirect bridge is <JUPLE_WEB_BASE_URL>/auth/callback (must be registered as an SPA redirect URI).
JUPLE_WEB_BASE_URL=http://localhost:3000

# "Install Juple" CTA on the Web Viewer (see lib/storeConfig.ts, app/c/[publicId]/InstallCta.tsx).
# All optional and unset by default - no real Google Play/App Store listing exists yet. Each CTA
# button is hidden entirely when its URL is unset; never fabricate a placeholder store URL here.
# APP_STORE_APP_ID is the separate numeric App Store id an iOS Smart App Banner needs
# (e.g. 123456789, no "id" prefix) - normally only known once a real App Store listing exists.
#GOOGLE_PLAY_URL=
#APP_STORE_URL=
#APP_STORE_APP_ID=

# Android App Links / iOS Universal Links verification files (see app/.well-known/*/route.ts) -
# both unset by default (each route then answers 404, a safe no-op) since neither a real Android
# release signing certificate nor a real Apple Developer Team ID exists yet. Never put a
# debug.keystore fingerprint here - see assetlinks.json/route.ts's comment for why.
#ANDROID_ASSETLINKS_SHA256_FINGERPRINTS=
#IOS_APP_ID=
