# The Juple Backend's base URL for the anonymous Public API (api/v1/public/*) only.
# Copy this file to .env.local and adjust if your local Backend runs on a different port.
# Falls back to http://localhost:5092 (see lib/publicApi.ts) if unset - no real Production
# domain is configured here; that value is TBD and must be supplied via real deployment
# configuration when it exists.
NEXT_PUBLIC_JUPLE_API_BASE_URL=http://localhost:5092

# "Install Juple" CTA on the Web Viewer (see lib/storeConfig.ts, app/c/[publicId]/InstallCta.tsx).
# All optional and unset by default - no real Google Play/App Store listing exists yet. Each CTA
# button is hidden entirely when its URL is unset; never fabricate a placeholder store URL here.
# NEXT_PUBLIC_APP_STORE_APP_ID is the separate numeric App Store id an iOS Smart App Banner needs
# (e.g. 123456789, no "id" prefix) - normally only known once a real App Store listing exists.
#NEXT_PUBLIC_GOOGLE_PLAY_URL=
#NEXT_PUBLIC_APP_STORE_URL=
#NEXT_PUBLIC_APP_STORE_APP_ID=

# Android App Links / iOS Universal Links verification files (see app/.well-known/*/route.ts) -
# both unset by default (each route then answers 404, a safe no-op) since neither a real Android
# release signing certificate nor a real Apple Developer Team ID exists yet. Never put a
# debug.keystore fingerprint here - see assetlinks.json/route.ts's comment for why.
#ANDROID_ASSETLINKS_SHA256_FINGERPRINTS=
#IOS_APP_ID=
