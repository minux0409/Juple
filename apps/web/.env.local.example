# The Juple Backend's base URL for the anonymous Public API (api/v1/public/*) only.
# Copy this file to .env.local and adjust if your local Backend runs on a different port.
# Falls back to http://localhost:5092 (see lib/publicApi.ts) if unset - no real Production
# domain is configured here; that value is TBD and must be supplied via real deployment
# configuration when it exists.
NEXT_PUBLIC_JUPLE_API_BASE_URL=http://localhost:5092
