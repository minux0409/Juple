{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RequestProtection": {
    "Enabled": true,
    "AnonymousIpLimitsEnabled": false,
    "AccountPerMinute": 180,
    "AnonymousPerMinute": 300,
    "ReadPerMinute": 120,
    "LinkPerMinute": 30,
    "MetadataPerMinute": 30,
    "ImagePerMinute": 15,
    "CollectionCreatePerMinute": 15,
    "SocialPerMinute": 40,
    "PushPerMinute": 10,
    "BulkPerMinute": 5,
    "PasswordPer15Minutes": 5,
    "PasswordVerificationPerMinute": 30,
    "AdminPerMinute": 60,
    "PublicReadPerMinute": 240,
    "MetadataPerAccountConcurrency": 2,
    "MetadataOutboundConcurrency": 4,
    "ImageConcurrency": 1,
    "ImageQueue": 2,
    "ImageRequestTimeoutSeconds": 120,
    "PasswordConcurrency": 2
  },
  "BlobStorage": {
    "ContainerName": "item-images"
  },
  "PublicWeb": {
    "BaseUrl": ""
  },
  "PublicCollectionCursor": {
    "EncryptionKey": ""
  },
  "CollectionUnlockGrant": {
    "EncryptionKey": ""
  },
  "MobileVersionPolicy": {
    "Android": { "LatestBuild": 0, "MinimumSupportedBuild": 0, "StoreUrl": "" },
    "Ios": { "LatestBuild": 0, "MinimumSupportedBuild": 0, "StoreUrl": "" }
  },
  "Billing": {
    "ProgramEnabled": false,
    "TrialDurationDays": 30
  }
}
